#Book {
    width: 100%;
    height: 100%;

    background-color: rgba(0, 0, 0, 0);

    flex-direction: column;
}

#BookContainer {
    width: 55%;
    height: 90%;

    align-self: center;

    flex-shrink: 0;

    flex-direction: column;

    background-color: rgb(49, 45, 54);
}

#Header {
    width: 100%;

    height: 70px;
    min-height: 70px;
    max-height: 70px;

    flex-grow: 0;
    flex-shrink: 0;

    flex-direction: row;

    align-items: center;
    justify-content: center;

    background-color: rgba(75, 52, 72, 0.90);
}

#Title {
    color: rgb(241, 229, 208);

    font-size: 28px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;
}

#CloseArea {
    position: absolute;

    right: 20px;

    height: 100%;

    justify-content: center;
}

#CloseButton {
    width: 100px;
    height: 40px;

    background-color: rgba(0, 0, 0, 0);

    border-width: 0;

    color: rgb(241, 229, 208);

    font-size: 16px;

    -unity-text-align: middle-center;
}

#CloseButton:hover {
    color: rgb(181, 148, 82);
}

#BookContent {
    width: 100%;

    flex-grow: 1;
    flex-shrink: 1;

    flex-direction: row;

    padding: 10px;
}

#Tabs {
    width: 190px;
    min-width: 190px;
    max-width: 190px;

    height: 100%;

    margin-right: 10px;

    padding-top: 15px;
    padding-bottom: 15px;
    padding-left: 10px;
    padding-right: 10px;

    background-color: rgb(224, 207, 181);

    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;

    border-top-color: rgb(174, 143, 119);
    border-bottom-color: rgb(174, 143, 119);
    border-left-color: rgb(174, 143, 119);
    border-right-color: rgb(174, 143, 119);

    flex-direction: column;
}

#RecipesTab,
#CompendiumTab,
#ObjectivesTab {
    height: 55px;

    min-height: 55px;
    max-height: 55px;

    margin-bottom: 8px;

    background-color: rgba(0, 0, 0, 0);

    border-width: 0;

    color: rgb(62, 49, 59);

    font-size: 17px;

    -unity-text-align: middle-left;
}

#RecipesTab:hover,
#CompendiumTab:hover,
#ObjectivesTab:hover {
    background-color: rgba(102, 72, 95, 0.15);

    color: rgb(102, 72, 95);
}

#PageArea {
    position: relative;

    flex-grow: 1;
    flex-shrink: 1;

    flex-direction: column;
}

#Page {
    width: 100%;

    flex-grow: 1;
    flex-shrink: 1;

    padding-top: 30px;
    padding-bottom: 25px;
    padding-left: 45px;
    padding-right: 45px;

    background-color: rgb(241, 229, 208);

    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;

    border-top-color: rgb(174, 143, 119);
    border-bottom-color: rgb(174, 143, 119);
    border-left-color: rgb(174, 143, 119);
    border-right-color: rgb(174, 143, 119);

    flex-direction: column;
}

#RecipeTitle {
    color: rgb(75, 52, 72);

    font-size: 30px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;

    margin-bottom: 25px;
}

#RecipeBody {
    flex-grow: 1;
    flex-shrink: 1;

    flex-direction: row;
}

#RecipeImage {
    width: 40%;
    height: 100%;

    -unity-scale-mode: scale-to-fit;
}

#RecipeInfo {
    width: 60%;

    padding-left: 30px;

    flex-direction: column;
}

#RecipeDescription {
    color: rgb(62, 49, 59);

    font-size: 22px;

    white-space: normal;

    margin-bottom: 30px;
    margin-left: -20px;

    flex-grow: 0;
    flex-shrink: 0;
}

#IngredientsTitle {
    color: rgb(102, 72, 95);

    font-size: 70px;

    -unity-font-style: bold;

    margin-bottom: 15px;
    margin-left: -20px;
}

#Ingredients {
    flex-direction: column;

    flex-grow: 0;
    flex-shrink: 0;

    height: auto;

    margin-left: -20px;

    margin-bottom: 25px;
}

.ingredient-entry {
    color: rgb(62, 49, 59);

    font-size: 50px;

    margin-bottom: 10px;
}

#PageNavigation {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 100%;

    flex-direction: row;

    justify-content: space-between;
    align-items: center;

    pointer-events: none;
}

#PreviousButton,
#NextButton {
    width: 45px;
    height: 70px;

    background-color: rgba(0, 0, 0, 0);
    border-width: 0;

    color: rgb(62, 49, 59);

    font-size: 55px;

    -unity-text-align: middle-center;
}

#PreviousButton {
    margin-left: -5px;
}

#NextButton {
    margin-right: -5px;
}

#PreviousButton:hover,
#NextButton:hover {
    color: rgb(102, 72, 95);
}

#PageNumber {
    position: absolute;

    right: 20px;
    bottom: 10px;

    color: rgb(62, 49, 59);

    font-size: 15px;

    margin-left: 0;
    margin-right: 0;

    -unity-text-align: middle-center;

    pointer-events: none;
}