#CompassViewport {
    position: relative;
    overflow: hidden;
}

#Background {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

#CompassContent {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

/* Todas las direcciones */
#Direction_N,
#Direction_NE,
#Direction_E,
#Direction_SE,
#Direction_S,
#Direction_SW,
#Direction_W,
#Direction_NW {
    position: absolute;
    top: 0;
    margin: 0;
    padding: 0;
}

/* Marcador central fijo */
#CenterMarker {
    position: absolute;
}

/* ============================= */
/*      BRÚJULA DORADA ✨         */
/* ============================= */

#Direction_N,
#Direction_NE,
#Direction_E,
#Direction_SE,
#Direction_S,
#Direction_SW,
#Direction_W,
#Direction_NW {

    /* Dorado base */
    color: rgb(232, 196, 112);

    font-size: 20px;

    unity-text-align: middle-center;

    -unity-font-style: bold;

    /* ✨ Glow violeta/dorado */
    text-shadow:
        0px 0px 2px rgb(255, 225, 150),
        0px 0px 5px rgb(190, 130, 255),
        0px 0px 10px rgb(85, 35, 120);
}


/* ============================= */
/*   DIRECCIONES PRINCIPALES ✨   */
/* ============================= */

#Direction_N,
#Direction_E,
#Direction_S,
#Direction_W {

    color: rgb(255, 221, 145);

    font-size: 24px;

    text-shadow:
        0px 0px 3px rgb(255, 235, 180),
        0px 0px 7px rgb(220, 170, 80),
        0px 0px 14px rgb(115, 55, 150);
}