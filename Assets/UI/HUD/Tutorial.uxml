<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="TutorialPanel" style="position: absolute; bottom: auto; left: 313px; width: 1235px; min-height: 97px; background-color: rgba(31, 0, 2, 0.851); border-top-left-radius: 40px; border-bottom-left-radius: 40px; border-top-right-radius: 40px; border-bottom-right-radius: 40px; padding: 20px 40px; flex-direction: column; align-items: center; top: 11px; right: auto;">
        <ui:Label text="Tutorial" name="TutorialName" style="color: rgb(255, 255, 255); font-size: 33px; -unity-text-align: upper-center; -unity-font-style: bold; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 0; background-color: rgba(0, 0, 0, 0);"/>
        <ui:Label text="Usa ASDW para moverte y E para interactuar con los objetos del ambiente" name="TutorialText" style="-unity-text-align: middle-center; white-space: normal; font-size: 24px; color: rgb(236, 217, 226); -unity-font-style: bold-and-italic; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 0; margin-top: 10px; width: 100%;"/>
        <ui:Button text="Siguiente" name="NextButton" style="width: 150px; white-space: nowrap; -unity-text-align: middle-center; align-self: flex-end; margin-top: 10px;"/>
    </ui:VisualElement>
</ui:UXML>
