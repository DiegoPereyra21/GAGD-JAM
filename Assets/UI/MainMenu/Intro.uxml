<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="IntroRoot" style="position: absolute; width: 100%; height: 100%; display: none;">
        <ui:VisualElement name="IntroBackground" style="position: absolute; width: 100%; height: 100%; background-color: rgb(0,0,0); -unity-background-scale-mode: scale-and-crop;"/>
        <ui:VisualElement style="position: absolute; width: 100%; height: 100%; background-color: rgba(0,0,0,0.35);"/>
        <ui:VisualElement name="IntroTextBox" style="position: absolute; bottom: 140px; left: 10%; width: 80%; height: 180px; justify-content: flex-end;">
            <ui:Label name="IntroText" text="" style="width: 100%; font-size: 34px; color: rgb(255,255,255); -unity-text-align: lower-center; white-space: normal; -unity-font-style: italic;"/>
        </ui:VisualElement>
        <ui:Label name="IntroPrompt" text="Presioná E para continuar" style="position: absolute; bottom: 50px; width: 100%; font-size: 20px; color: rgb(220,220,220); -unity-text-align: middle-center; display: none;"/>
        <ui:VisualElement name="FadeOverlay" style="position: absolute; width: 100%; height: 100%; background-color: rgb(0,0,0); opacity: 0;"/>
    </ui:VisualElement>
</ui:UXML>