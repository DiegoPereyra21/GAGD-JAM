        <ui:VisualElement style="position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.35);"/>
        <ui:VisualElement name="IntroTextBox" style="position: absolute; top: 80px; left: 10%; width: 80%; height: 220px; justify-content: flex-start;">
            <ui:Label name="IntroText" text="" style="width: 100%; font-size: 49px; color: rgb(255, 255, 255); -unity-text-align: middle-center; white-space: normal; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&amp;guid=18f4c9b27a364ec4582c28b0363973e9&amp;type=3#JimNightshade-Regular&quot;); -unity-text-outline-width: 1px;"/>
