:root {

}

.main-menu {
    width: 100%;
    height: 100%;

    flex-grow: 1;
}

.content {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.menu-container {
    align-items: center;
    padding-top:20%;

    align-items: center;
    margin-top: 30px;
}

.logo {
    width: 400px;
    height: 150px;
}

.background {
    flex-grow: 1;

    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    background-image: url("/Assets/Art/menu_background1.png");
    -unity-background-scale-mode: scale-and-crop;
}

.title {
    transform-origin: 50% 50%;

    position: relative;
    overflow: visible;

    -unity-font-definition: url("/Assets/Art/Fonts/JimNightshade-Regular.ttf");
    font-size: 150px;

    margin-top: 0;
    margin-bottom:100px;

    color: rgb(235, 215, 170);

    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(220, 180, 90, 0.45);

    width: 100%;
    -unity-text-align: middle-center;
}

.title-sparkle {
    position: absolute;

    border-radius: 50%;

    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;

    picking-mode: ignore;
}

.menu-button {
    width: 400px;
    height: 100px;

    margin: 20px 0;

    -unity-font-definition: url("/Assets/Art/Fonts/JimNightshade-Regular.ttf");
    font-size: 64px;

    /* Texto */
    color: rgb(238, 226, 205);

    /* Cristal espectral */
    background-color: rgba(61, 43, 82, 0.38);

    /* Borde */
    border-width: 0.5px;
    border-color: rgba(190, 165, 220, 0.55);
    border-radius: 12px;

    /* Halo del texto */
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 235, 210, 0.35);

    /* Transición */
    transition-property: scale, color, background-color, border-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.menu-button:hover {
    scale: 1.05 1.05;

    /* Texto mucho más luminoso */
    color: rgb(255, 241, 190);

    /* El cristal se vuelve más visible */
    background-color: rgba(104, 70, 135, 0.52);

    /* Borde espectral */
    border-color: rgba(220, 190, 255, 0.9);

    /* Glow alrededor de las letras */
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(255, 220, 160, 0.75);
}

.sparkles {
    picking-mode: ignore;
    position: absolute;

    left: -20px;
    top: -20px;
    right: -20px;
    bottom: -20px;

    overflow: visible;

    pointer-events: none;
}

.sparkle {
    position: absolute;

    width: 4px;
    height: 4px;

    background-color: rgba(255, 230, 170, 0.9);

    border-radius: 50%;

    opacity: 0;
}
