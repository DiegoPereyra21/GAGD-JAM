:root {
}

.main-menu {
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

.content {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.menu-container {
    align-items: center;
    padding-top: 20%;
    margin-top: 30px;
}

.background {
    flex-grow: 1;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("/Assets/Art/menu_background1.png");
    -unity-background-scale-mode: scale-and-crop;
}

.logo {
    width: 400px;
    height: 150px;
}

.title {
    transform-origin: 50% 50%;
    position: relative;
    overflow: visible;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&guid=18f4c9b27a364ec4582c28b0363973e9&type=3#JimNightshade-Regular");
    font-size: 150px;
    margin-top: 0;
    margin-bottom: 100px;
    color: rgb(235, 215, 170);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(220, 180, 90, 0.45);
    width: 100%;
    -unity-text-align: middle-center;
}

.title-sparkle {
    position: absolute;
    border-radius: 50%;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
    -unity-picking-mode: ignore;
}

.menu-button {
    width: 400px;
    height: 100px;
    margin: 20px 0;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&guid=18f4c9b27a364ec4582c28b0363973e9&type=3#JimNightshade-Regular");
    font-size: 64px;
    color: rgb(238, 226, 205);
    background-color: rgba(61, 43, 82, 0.38);
    border-width: 0.5px;
    border-color: rgba(190, 165, 220, 0.55);
    border-radius: 12px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 235, 210, 0.35);
    transition-property: scale, color, background-color, border-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.menu-button:hover {
    scale: 1.05 1.05;
    color: rgb(255, 241, 190);
    background-color: rgba(104, 70, 135, 0.52);
    border-color: rgba(220, 190, 255, 0.9);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(255, 220, 160, 0.75);
}

.sparkles {
    position: absolute;
    left: -20px;
    top: -20px;
    right: -20px;
    bottom: -20px;
    overflow: visible;
    -unity-picking-mode: ignore;
}

.sparkle {
    position: absolute;
    width: 4px;
    height: 4px;
    background-color: rgba(255, 230, 170, 0.9);
    border-radius: 50%;
    opacity: 0;
}

.options-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 1800px;
    height: 1000px;
    display: flex;
    flex-direction: column;
    background-color: rgba(25, 18, 40, 0.92);
    border-width: 1px;
    border-color: rgba(190, 165, 220, 0.35);
    border-radius: 20px;
    overflow: hidden;
}

#OptionsTitle {
    height: 110px;
    flex-shrink: 0;
    margin-top: 20px;
    color: rgb(235, 215, 170);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&guid=18f4c9b27a364ec4582c28b0363973e9&type=3#JimNightshade-Regular");
    font-size: 70px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(220, 180, 90, 0.40);
}

#OptionsPanel {
    display: flex;
    flex-direction: column;
}

#LanguageSection {
    width: 100%;
    height: auto;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    padding-left: 80px;
    padding-right: 80px;
    padding-top: 20px;
    padding-bottom: 25px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(190, 165, 220, 0.25);
}

#LanguageLabel {
    color: rgb(235, 215, 170);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&guid=18f4c9b27a364ec4582c28b0363973e9&type=3#JimNightshade-Regular");
    font-size: 42px;
    margin-bottom: 20px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(220, 180, 90, 0.35);
}

#SpanishToggle,
#EnglishToggle {
    width: 500px;
    height: 60px;
    flex-shrink: 0;
    margin-bottom: 10px;
    padding-left: 25px;
    padding-right: 20px;
    background-color: rgba(61, 43, 82, 0.45);
    border-width: 1px;
    border-color: rgba(190, 165, 220, 0.35);
    border-radius: 10px;
    color: rgb(225, 215, 205);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&guid=18f4c9b27a364ec4582c28b0363973e9&type=3#JimNightshade-Regular");
    font-size: 32px;
}

#SpanishToggle:hover,
#EnglishToggle:hover {
    scale: 1.03 1.03;
    background-color: rgba(90, 55, 115, 0.65);
    border-color: rgba(220, 190, 240, 0.75);
    color: rgb(245, 225, 185);
}

#SpanishToggle:checked,
#EnglishToggle:checked {
    background-color: rgba(105, 70, 125, 0.80);
    border-color: rgba(235, 205, 150, 0.90);
    color: rgb(245, 220, 165);
}

#SpanishToggle .unity-base-field__label,
#EnglishToggle .unity-base-field__label,
#SpanishToggle .unity-toggle__label,
#EnglishToggle .unity-toggle__label {
    color: rgb(225, 215, 220);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&guid=18f4c9b27a364ec4582c28b0363973e9&type=3#JimNightshade-Regular");
    font-size: 32px;
    -unity-text-align: middle-left;
}

#SpanishToggle:hover .unity-base-field__label,
#EnglishToggle:hover .unity-base-field__label,
#SpanishToggle:hover .unity-toggle__label,
#EnglishToggle:hover .unity-toggle__label {
    color: rgb(245, 225, 185);
}

#SpanishToggle:checked .unity-base-field__label,
#EnglishToggle:checked .unity-base-field__label,
#SpanishToggle:checked .unity-toggle__label,
#EnglishToggle:checked .unity-toggle__label {
    color: rgb(245, 220, 165);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 220, 160, 0.35);
}

#SpanishToggle .unity-toggle__checkmark,
#EnglishToggle .unity-toggle__checkmark {
    width: 22px;
    height: 22px;
    border-width: 2px;
    border-color: rgba(220, 190, 240, 0.65);
    border-radius: 50%;
    background-color: rgba(25, 18, 40, 0.70);
}

#SpanishToggle:checked .unity-toggle__checkmark,
#EnglishToggle:checked .unity-toggle__checkmark {
    background-color: rgb(220, 180, 90);
    border-color: rgb(245, 215, 150);
}

#AudioSection {
    width: 100%;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 80px;
    padding-right: 80px;
    padding-top: 30px;
    padding-bottom: 25px;
}

#AudioLabel {
    color: rgb(235, 215, 170);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&guid=18f4c9b27a364ec4582c28b0363973e9&type=3#JimNightshade-Regular");
    font-size: 42px;
    margin-bottom: 25px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(220, 180, 90, 0.35);
}

#MusicRow,
#SFXRow,
#AmbientRow {
    width: 850px;
    height: 55px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

#MusicLabel,
#SFXLabel,
#AmbientLabel {
    width: 150px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 25px;
    color: rgb(225, 215, 205);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&guid=18f4c9b27a364ec4582c28b0363973e9&type=3#JimNightshade-Regular");
    font-size: 30px;
    -unity-text-align: middle-left;
}

#MusicSlider,
#SFXSlider,
#AmbientSlider {
    width: 600px;
    height: 45px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
}

#MusicSlider .unity-base-slider__tracker,
#SFXSlider .unity-base-slider__tracker,
#AmbientSlider .unity-base-slider__tracker {
    height: 6px;
    background-color: rgba(190, 165, 220, 0.35);
    border-radius: 3px;
}

#MusicSlider .unity-base-slider__dragger,
#SFXSlider .unity-base-slider__dragger,
#AmbientSlider .unity-base-slider__dragger {
    width: 22px;
    height: 22px;
    background-color: rgb(220, 180, 90);
    border-width: 2px;
    border-color: rgb(245, 215, 150);
    border-radius: 50%;
}

#MusicSlider:hover .unity-base-slider__dragger,
#SFXSlider:hover .unity-base-slider__dragger,
#AmbientSlider:hover .unity-base-slider__dragger {
    background-color: rgb(245, 215, 150);
    border-color: rgb(255, 235, 180);
    scale: 1.15 1.15;
}

#BackButton {
    position: absolute;
    right: 35px;
    bottom: 30px;
    width: 220px;
    height: 70px;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&guid=18f4c9b27a364ec4582c28b0363973e9&type=3#JimNightshade-Regular");
    font-size: 38px;
    color: rgb(238, 226, 205);
    background-color: rgba(61, 43, 82, 0.60);
    border-width: 1px;
    border-color: rgba(190, 165, 220, 0.55);
    border-radius: 10px;
    -unity-text-align: middle-center;
    transition-property:
        background-color,
        color,
        border-color,
        scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

#BackButton:hover {
    scale: 1.05 1.05;
    color: rgb(255, 241, 190);
    background-color: rgba(104, 70, 135, 0.75);
    border-color: rgba(235, 205, 150, 0.90);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 220, 160, 0.70);
}

.confirm-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 900px;
    height: 350px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(25, 18, 40, 0.92);
    border-width: 1px;
    border-color: rgba(190, 165, 220, 0.35);
    border-radius: 20px;
    padding: 40px;
}

.confirm-label {
    color: rgb(235, 215, 170);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/JimNightshade-Regular.ttf?fileID=12800000&guid=18f4c9b27a364ec4582c28b0363973e9&type=3#JimNightshade-Regular");
    font-size: 42px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 40px;
}

.confirm-buttons-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.confirm-button {
    width: 280px;
    height: 90px;
    margin: 0 20px;
}

.menu-button:disabled {
    opacity: 0.35;
    color: rgb(150, 140, 160);
    -unity-text-outline-width: 0;
}

.menu-button:disabled:hover {
    scale: 1 1;
    background-color: rgba(61, 43, 82, 0.38);
    border-color: rgba(190, 165, 220, 0.55);
}

#PauseMenuRoot .menu-container {
    padding-top: 5%;
    margin-top: 0;
}