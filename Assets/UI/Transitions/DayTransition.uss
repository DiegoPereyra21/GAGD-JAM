.day-transition-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    background-color: rgba(0, 0, 0, 0.75);

    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.day-transition-title {
    color: rgb(235, 205, 150);
    font-size: 130px;

    -unity-text-align: middle-center;

    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(50, 25, 60, 0.8);

    text-shadow: 0 0 14px rgba(235, 205, 150, 0.45);
}

.day-transition-subtitle {
    margin-top: 20px;

    color: rgba(235, 220, 190, 0.75);
    font-size: 42px;

    -unity-text-align: middle-center;

    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(50, 25, 60, 0.8);

    letter-spacing: 2px;

    transition-property: opacity, translate;
    transition-duration: 2s;
    transition-timing-function: ease-in-out;
}