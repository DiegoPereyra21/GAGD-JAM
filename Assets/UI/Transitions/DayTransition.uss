/* titulo y subtitulo */
.day-transition-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    background-color: rgba(0, 0, 0, 0.75);

    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding-top: 100px;
}

.day-transition-title {
    color: rgb(235, 205, 150);
    font-size: 130px;
    width: 100%;

    -unity-text-align: middle-center;

    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(50, 25, 60, 0.8);
}

.day-transition-subtitle {
    color: rgb(235, 205, 150);
    font-size: 42px;
    width: 100%;

    -unity-text-align: middle-center;

    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(50, 25, 60, 0.8);

    letter-spacing: 2px;

    opacity: 0.75;

    transition-property: opacity, translate;
    transition-duration: 1.8s;
    transition-timing-function: ease-in-out;
}

.day-transition-subtitle.breathing {
    opacity: 1;
    translate: 0 3px;
}

/* iconos */
.transition-icons {
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
}

.transition-item {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    margin-left: 60px;
    margin-right: 60px;
}

.money-text,
.inventory-text,
.sanity-text {
    color: rgb(235, 205, 150);
    font-size: 34px;
    -unity-text-align: middle-center;
    margin-bottom: 15px;
}

.transition-icon {
    width: 140px;
    height: 140px;
    margin-bottom: 15px;
}

.item-value {
    color: rgb(235, 205, 150);
    font-size: 34px;
    -unity-text-align: middle-center;
}